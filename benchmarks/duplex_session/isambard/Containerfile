# vLLM-Omni image for Isambard-AI (GH200, linux/arm64), long-context duplex profiling.
# Prototype (branch long-context-prototype). Build from the repo root:
#   podman-hpc build -f benchmarks/duplex_session/isambard/Containerfile -t vllm-omni-lc .
# The base image's vllm/torch stack is pinned as a constraint for every later
# install: step-audio2 requires unpinned torch/torchaudio, and replacing the
# base torch or vllm can leave vllm's compiled extension mismatched.
ARG BASE_IMAGE=docker.io/vllm/vllm-openai:v0.32.0
FROM ${BASE_IMAGE}

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git jq curl ffmpeg && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN PY="$(python3 -c 'import sys; print(sys.executable)')" && \
    uv pip freeze --python "$PY" | grep -iE '^(vllm|torch|torchaudio|torchvision|triton|xformers|flashinfer[a-z_-]*)==' \
        > /app/base-constraints.txt && \
    cat /app/base-constraints.txt && \
    python3 -c "import importlib.util as u, sys; sys.exit(u.find_spec('vllm._C_stable_libtorch') is None)" && echo "base vllm extension present"

COPY . /app/vllm-omni
RUN PY="$(python3 -c 'import sys; print(sys.executable)')" && \
    uv pip install --python "$PY" --no-cache-dir -c /app/base-constraints.txt "/app/vllm-omni" && \
    uv pip install --python "$PY" --no-cache-dir -c /app/base-constraints.txt \
        step-audio2==1.0.0 datasets==3.6.0 av matplotlib websockets && \
    python3 -c "import importlib.util as u, sys; sys.exit(u.find_spec('vllm._C_stable_libtorch') is None)" && echo "vllm extension still present" && cat /app/base-constraints.txt
RUN ln -sf /usr/bin/python3 /usr/bin/python
ENTRYPOINT []
